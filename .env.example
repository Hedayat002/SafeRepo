# ============================================================
# SafeRepo — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local to source control.
# ============================================================

# --- Local Development ---

# MongoDB (local Docker via docker-compose)
MONGODB_URI=mongodb://admin:password@localhost:27017/saferepo?authSource=admin

# GitHub App (create at https://github.com/settings/apps)
GITHUB_APP_ID=your_github_app_id
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----"

# Session
SESSION_SECRET=generate_a_random_32_character_string_here

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Scanner (Phase 02+)
SCAN_TIMEOUT_SECONDS=300
# SCANNER_MEMORY_LIMIT=512m
# SCANNER_CPU_LIMIT=1

# Retention & Data Management (Phase 08)
SCAN_RETENTION_DAYS=90
MAX_SCANS_PER_USER=500

# --- Future Production (Phase 09) ---
# These are NOT used in local development.
# They will be configured in the hosting platform's environment.

# MONGODB_URI=mongodb+srv://...@cluster.mongodb.net/saferepo
# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://your-production-domain.com
# ALLOWED_ORIGINS=https://your-production-domain.com
